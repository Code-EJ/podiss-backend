# Copy to .env.dev (ignored). Local Docker only, never production credentials.
# Generate distinct random values; passwords must be single-line.
DEV_DB_PASSWORD=
DEV_DB_ROOT_PASSWORD=
# Base64 of at least 64 random bytes, NOT a human password.
DEV_JWT_SECRET=
# At least 12 characters, no more than 72 UTF-8 bytes.
DEV_ADMIN_PASSWORD=
DEV_HTTP_PORT=18080
DEV_CORS_ALLOWED_ORIGINS=http://localhost:5173
