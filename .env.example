# Créditos: oEnzoRibas
# Template for Spring run directly (IDE EnvFile), NOT Docker.
# Copy to .env and fill values; Spring does not automatically read .env.
# Docker local uses .env.dev.example -> .env.dev instead.
# Details: docs/configuration/environment.md
DB_URL=jdbc:mariadb://127.0.0.1:3306/REPLACE_WITH_LOCAL_DATABASE
DB_USERNAME=
DB_PASSWORD=
HIKARI_MAX_LIFETIME=1800000
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5

# Required: Base64 of at least 64 random bytes. No usable default.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional bootstrap: fill ALL three or leave ALL empty.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
YOUTUBE_API_KEY=

# Only used by profile prod when TLS terminates directly in Spring.
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_ALIAS=server






