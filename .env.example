# ==============================================================================
# PODISS BACKEND - ENVIRONMENTAL VARIABLES
# ==============================================================================

# Database Configuration (MariaDB)
DB_URL=jdbc:mariadb://localhost:3306/podiss_db
DB_USERNAME=podiss_user
DB_PASSWORD=1uQ=podiss_password
HIKARI_MAX_LIFETIME=1800000

# Security / JWT
# ATENÇÃO: Deve conter pelo menos 64 bytes (512 bits) em Base64 para o algoritmo HS512.
# Gere via: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=RaboDoMacacoDoido

# CORS Configuration (comma-separated origins em produção)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First-Run System Bootstrap (Admin Credentials)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@podiss.com.br
ADMIN_PASSWORD=change_this_secure_password

# External Integrations
YOUTUBE_API_KEY=

# SSL / TLS Configuration (Optional - only required if SSL_ENABLED=true)
SSL_ENABLED=false
SSL_KEY_STORE=classpath:server.p12
SSL_KEY_STORE_PASSWORD=
SSL_KEY_ALIAS=server






